// Janela principal: barra lateral, lista de salas, área central e barra de status.

import { Theme, InputState, NavAction, TextOps } from "theme.slint";
import { FocusRing, VButton, LiveBadge } from "widgets.slint";
import { VirtualKeyboard } from "keyboard.slint";
import { HomePage, StreamPage, RoomsPage, LivePage, SettingsPage, AccountPage, PlansPage, AboutPage, SourceItem, RoomItem } from "pages.slint";

export { InputState, NavAction, TextOps, SourceItem, RoomItem }
export { LiveControlsState, LiveSourceItem } from "live_controls.slint";

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <int> focus-token;
    callback activated;

    height: 56px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.bg-3 : (ta.has-hover ? Theme.bg-2 : transparent);
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.activated(); }

    // A janela incrementa o token ao trocar de seção pelo controle;
    // o item selecionado assume o foco.
    changed focus-token => {
        if (root.selected) { fs.focus(); }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        clicked => {
            fs.focus();
            root.activated();
        }
    }
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 24px : 0;
        y: (parent.height - self.height) / 2;
        background: Theme.accent;
        border-radius: 2px;
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Image {
            source: root.icon;
            height: 22px;
            colorize: root.selected ? Theme.accent : Theme.text-secondary;
            image-fit: contain;
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 11px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    FocusRing { visible-ring: fs.has-focus; }
}

component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated;
    height: 44px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent : (ta.has-hover ? Theme.bg-hover : transparent);
    ta := TouchArea { clicked => { root.activated(); } }
    Text {
        x: Theme.sp-4;
        text: root.label;
        color: root.selected ? Theme.on-accent : Theme.text-primary;
        font-size: Theme.fs-body-strong;
        vertical-alignment: center;
    }
    FocusRing { visible-ring: root.selected; radius: Theme.radius-sm; }
}

export component AppWindow inherits Window {
    title: "Vellcast";
    icon: @image-url("icons/cast.svg");
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1180px;
    preferred-height: 720px;
    // Alternar `repaint-toggle` força o renderer a redesenhar a janela inteira:
    // o gradiente de uma cor só tem os mesmos pixels da cor sólida (issue #6).
    in property <bool> repaint-toggle;
    background: root.repaint-toggle ? @linear-gradient(0deg, Theme.bg-0 0%, Theme.bg-0 100%) : Theme.bg-0;
    default-font-size: Theme.fs-body;

    in-out property <int> current-page: 0;
    in property <int> nav-focus-token;
    in property <[string]> gamepads;
    in property <string> version;
    in property <string> update-status;
    in property <bool> update-error;
    in property <bool> update-available;
    in property <bool> update-busy;
    in property <[string]> licenses;
    in property <bool> tray-available;
    in property <bool> rooms-collapsed: false;

    // Configurações (espelho do arquivo; o Rust persiste a cada mudança).
    in-out property <int> language-index;
    in-out property <string> display-name;
    in-out property <float> deadzone;
    in-out property <float> repeat-delay;
    in-out property <float> repeat-interval;
    in-out property <bool> start-minimized;
    in-out property <bool> close-to-tray;
    in property <bool> background-shortcuts;
    in-out property <string> relay-url;
    in-out property <string> room-key;
    in-out property <string> public-url;
    in property <string> relay-message;
    in property <bool> relay-message-error;

    // Transmitir
    in property <[SourceItem]> sources;
    in-out property <int> selected-source: -1;
    in property <string> sources-message;
    in property <bool> sources-loading;
    in-out property <int> profile;
    in-out property <int> custom-height-index;
    in-out property <int> custom-fps-index;
    in-out property <float> custom-bitrate;
    in property <string> quality-summary;
    in-out property <int> audio-index;
    in property <[string]> encoder-options;
    in-out property <int> encoder-index;
    in-out property <int> stream-room-index;
    in property <bool> starting;
    in property <string> stream-message;
    in property <bool> stream-message-error;

    // Salas
    in property <[RoomItem]> rooms;
    in property <[string]> room-names;
    in-out property <int> rooms-index: -1;
    in-out property <string> new-room-name;
    in property <bool> rooms-busy;
    in property <string> rooms-message;
    in property <bool> rooms-message-error;
    in property <string> invite-link;
    in property <string> pairing-code;

    // Ao vivo
    in property <bool> live;
    in property <string> live-status;
    in property <string> live-source;
    in property <string> live-room;
    in property <string> live-uptime;
    in property <string> live-viewers;
    in property <string> live-video;
    in property <string> live-captured-fps;
    in property <string> live-encoded-fps;
    in property <string> live-bitrate;
    in property <string> live-dropped;
    in property <string> live-encode-ms;
    in property <string> live-rtt;
    in property <string> live-target;
    in property <string> live-app-cpu;
    in property <string> live-app-ram;
    in property <string> live-message;
    in property <bool> live-message-error;

    // 0 = nenhum, 1 = teclado virtual, 2 = menu rápido.
    out property <int> modal: 0;
    property <int> menu-index: 0;
    property <int> refocus-token: 0;
    property <int> plan-tab: 0;
    property <length> scroll-y: 0;

    callback navigate(int);
    callback settings-changed;
    callback language-selected(int);
    callback minimize-to-tray;
    callback quit-app;
    callback check-updates;
    callback install-update;
    callback test-relay;
    callback refresh-sources;
    callback stream-prefs-changed;
    callback start-stream;
    callback stop-stream;
    callback create-room(string);
    callback make-invite(int);
    callback make-pairing(int);
    callback make-live-invite;
    callback copy-invite;
    callback close-room(int);

    // Entrar em salas (Início) e compartilhamento por participantes (issue #4).
    in-out property <string> join-link;
    in property <bool> joining;
    in property <string> home-message;
    in property <bool> home-message-error;
    in property <string> room-share-status;
    in property <bool> room-share-active;
    in property <bool> room-share-mine;
    callback join-room(string);
    callback paste-invite;
    callback create-room-from-home;
    callback refresh-room-status(int);
    callback share-screen(int);
    callback stop-share;
    callback watch-room(int);
    callback leave-room(int);

    // Campo que o teclado virtual está editando: 0 nome, 1 servidor, 2 chave, 3 nome da sala, 4 endereço público, 5 link de convite.
    property <int> keyboard-target: 0;

    property <[{icon: image, label: string}]> nav-items: [
        { icon: @image-url("icons/house.svg"), label: @tr("Home") },
        { icon: @image-url("icons/cast.svg"), label: @tr("Stream") },
        { icon: @image-url("icons/users.svg"), label: @tr("Rooms") },
        { icon: @image-url("icons/radio.svg"), label: @tr("Live") },
        { icon: @image-url("icons/settings.svg"), label: @tr("Settings") },
        { icon: @image-url("icons/circle-user.svg"), label: @tr("Account") },
        { icon: @image-url("icons/gem.svg"), label: @tr("Plans") },
        { icon: @image-url("icons/info.svg"), label: @tr("About") },
    ];
    out property <int> page-count: self.nav-items.length;

    property <[string]> menu-items: [@tr("Home"), @tr("Settings"), @tr("Minimize to tray"), @tr("Quit Vellcast")];

    changed current-page => { root.scroll-y = 0; }

    public function open-menu() {
        root.menu-index = 0;
        root.modal = 2;
        menu-fs.focus();
    }

    // Abre o teclado virtual para o nome de exibição (atalho usado em testes).
    public function open-keyboard() {
        root.open-keyboard-for(0, root.display-name);
    }

    public function open-keyboard-for(target: int, value: string) {
        root.keyboard-target = target;
        vk.value = value;
        root.modal = 1;
        vk.open();
    }

    function keyboard-confirmed(text: string) {
        if (root.keyboard-target == 0) {
            root.display-name = text;
            root.settings-changed();
        } else if (root.keyboard-target == 1) {
            root.relay-url = text;
            root.settings-changed();
        } else if (root.keyboard-target == 2) {
            root.room-key = text;
            root.settings-changed();
        } else if (root.keyboard-target == 4) {
            root.public-url = text;
            root.settings-changed();
        } else if (root.keyboard-target == 5) {
            root.join-link = text;
        } else {
            root.new-room-name = text;
        }
        root.close-modal();
    }

    function close-modal() {
        root.modal = 0;
        root.refocus-token += 1;
    }

    function run-menu(i: int) {
        root.close-modal();
        if (i == 0) {
            root.navigate(0);
        } else if (i == 1) {
            root.navigate(4);
        } else if (i == 2) {
            root.minimize-to-tray();
        } else {
            root.quit-app();
        }
    }

    // Ações do controle enquanto um modal está aberto.
    public function modal-action(a: NavAction) {
        if (root.modal == 1) {
            vk.action(a);
        } else if (root.modal == 2) {
            if (a == NavAction.up) {
                root.menu-index = max(0, root.menu-index - 1);
            } else if (a == NavAction.down) {
                root.menu-index = min(root.menu-items.length - 1, root.menu-index + 1);
            } else if (a == NavAction.confirm) {
                root.run-menu(root.menu-index);
            } else if (a == NavAction.back || a == NavAction.menu) {
                root.close-modal();
            }
        }
    }

    // LT/RT: abas da tela atual (hoje, só Planos tem abas).
    public function tab-step(direction: int) {
        if (root.current-page == 6) {
            root.plan-tab = Math.mod(root.plan-tab + direction + 3, 3);
        }
    }

    // Analógico direito: rolagem da área central.
    public function scroll-step(direction: int) {
        root.scroll-y = clamp(root.scroll-y - direction * 80px, min(0px, flick.height - flick.content-height), 0px);
    }

    HorizontalLayout {
        width: root.width;
        height: root.height;
        // Barra lateral
        Rectangle {
            width: 96px;
            horizontal-stretch: 0;
            background: Theme.bg-0;
            VerticalLayout {
                padding: Theme.sp-2;
                spacing: Theme.sp-1;
                Rectangle {
                    height: 48px;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 8px;
                        background: Theme.accent;
                        Text { text: "V"; color: Theme.on-accent; font-size: 18px; font-weight: 800; }
                    }
                }
                for item[i] in root.nav-items: NavItem {
                    icon: item.icon;
                    label: item.label;
                    selected: root.current-page == i;
                    focus-token: root.nav-focus-token;
                    activated => { root.navigate(i); }
                }
                Rectangle { }
            }
        }

        // Lista de salas (recolhe abaixo de 1200 px, UX_GUIDELINES §6).
        // `rooms-collapsed` vem do Rust no redimensionamento, para não criar
        // laço entre a largura da janela e o layout.
        if !root.rooms-collapsed: Rectangle {
            width: 240px;
            background: Theme.bg-1;
            VerticalLayout {
                padding: Theme.sp-4;
                spacing: Theme.sp-2;
                Text { text: @tr("ROOMS"); color: Theme.text-secondary; font-size: Theme.fs-caption; font-weight: 600; }
                if root.rooms.length == 0: Text {
                    text: @tr("No rooms yet. Create one in Rooms.");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    wrap: word-wrap;
                }
                for room in root.rooms: HorizontalLayout {
                    spacing: Theme.sp-2;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: room.live ? Theme.danger : Theme.text-muted;
                    }
                    Text {
                        text: room.name;
                        color: room.live ? Theme.text-primary : Theme.text-secondary;
                        font-size: Theme.fs-body;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle { }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                background: Theme.bg-2;
                flick := Flickable {
                    content-y <=> root.scroll-y;
                    content-width: self.width;
                    content-height: max(self.height, content.preferred-height);
                    content := VerticalLayout {
                        width: flick.width;
                        padding: Theme.sp-8;
                        alignment: start;
                        if root.current-page == 0: HomePage {
                            display-name: root.display-name;
                            gamepads: root.gamepads;
                            live: root.live;
                            room-count: root.rooms.length;
                            navigate(i) => { root.navigate(i); }
                            join-link <=> root.join-link;
                            joining: root.joining;
                            rooms-busy: root.rooms-busy;
                            message: root.home-message;
                            message-error: root.home-message-error;
                            refocus-token: root.refocus-token;
                            create-room => { root.create-room-from-home(); }
                            join-room(link) => { root.join-room(link); }
                            paste-invite => { root.paste-invite(); }
                            request-virtual-keyboard(t) => { root.open-keyboard-for(5, t); }
                        }
                        if root.current-page == 1: StreamPage {
                            sources: root.sources;
                            selected-source <=> root.selected-source;
                            sources-message: root.sources-message;
                            sources-loading: root.sources-loading;
                            profile <=> root.profile;
                            custom-height-index <=> root.custom-height-index;
                            custom-fps-index <=> root.custom-fps-index;
                            custom-bitrate <=> root.custom-bitrate;
                            quality-summary: root.quality-summary;
                            audio-index <=> root.audio-index;
                            encoder-options: root.encoder-options;
                            encoder-index <=> root.encoder-index;
                            room-options: root.room-names;
                            room-index <=> root.stream-room-index;
                            live: root.live;
                            starting: root.starting;
                            message: root.stream-message;
                            message-error: root.stream-message-error;
                            refresh-sources => { root.refresh-sources(); }
                            prefs-changed => { root.stream-prefs-changed(); }
                            start-clicked => { root.start-stream(); }
                            navigate(i) => { root.navigate(i); }
                        }
                        if root.current-page == 2: RoomsPage {
                            rooms: root.rooms;
                            room-index <=> root.rooms-index;
                            relay-url: root.relay-url;
                            refocus-token: root.refocus-token;
                            new-room-name <=> root.new-room-name;
                            busy: root.rooms-busy;
                            message: root.rooms-message;
                            message-error: root.rooms-message-error;
                            invite-link: root.invite-link;
                            pairing-code: root.pairing-code;
                            create-room(name) => { root.create-room(name); }
                            make-invite(i) => { root.make-invite(i); }
                            make-pairing(i) => { root.make-pairing(i); }
                            copy-invite => { root.copy-invite(); }
                            close-room(i) => { root.close-room(i); }
                            request-virtual-keyboard(t) => { root.open-keyboard-for(3, t); }
                            share-status: root.room-share-status;
                            share-active: root.room-share-active;
                            share-mine: root.room-share-mine;
                            starting: root.starting;
                            refresh-status(i) => { root.refresh-room-status(i); }
                            share-screen(i) => { root.share-screen(i); }
                            stop-share => { root.stop-share(); }
                            watch-room(i) => { root.watch-room(i); }
                            leave-room(i) => { root.leave-room(i); }
                        }
                        if root.current-page == 3: LivePage {
                            live: root.live;
                            status: root.live-status;
                            source-title: root.live-source;
                            room-name: root.live-room;
                            uptime: root.live-uptime;
                            viewers: root.live-viewers;
                            video: root.live-video;
                            captured-fps: root.live-captured-fps;
                            encoded-fps: root.live-encoded-fps;
                            bitrate: root.live-bitrate;
                            dropped: root.live-dropped;
                            encode-ms: root.live-encode-ms;
                            rtt: root.live-rtt;
                            target: root.live-target;
                            app-cpu: root.live-app-cpu;
                            app-ram: root.live-app-ram;
                            message: root.live-message;
                            message-error: root.live-message-error;
                            invite-link: root.invite-link;
                            stop => { root.stop-stream(); }
                            make-invite => { root.make-live-invite(); }
                            copy-invite => { root.copy-invite(); }
                            navigate(i) => { root.navigate(i); }
                        }
                        if root.current-page == 4: SettingsPage {
                            tray-available: root.tray-available;
                            refocus-token: root.refocus-token;
                            language-index <=> root.language-index;
                            display-name <=> root.display-name;
                            deadzone <=> root.deadzone;
                            repeat-delay <=> root.repeat-delay;
                            repeat-interval <=> root.repeat-interval;
                            start-minimized <=> root.start-minimized;
                            close-to-tray <=> root.close-to-tray;
                            background-shortcuts: root.background-shortcuts;
                            relay-url <=> root.relay-url;
                            room-key <=> root.room-key;
                            public-url <=> root.public-url;
                            relay-message: root.relay-message;
                            relay-message-error: root.relay-message-error;
                            changed-setting => { root.settings-changed(); }
                            language-selected(i) => { root.language-selected(i); }
                            request-virtual-keyboard(target, t) => { root.open-keyboard-for(target, t); }
                            test-relay => { root.test-relay(); }
                        }
                        if root.current-page == 5: AccountPage { }
                        if root.current-page == 6: PlansPage { tab <=> root.plan-tab; }
                        if root.current-page == 7: AboutPage {
                            version: root.version;
                            licenses: root.licenses;
                            update-status: root.update-status;
                            update-error: root.update-error;
                            update-available: root.update-available;
                            update-busy: root.update-busy;
                            check-updates => { root.check-updates(); }
                            install-update => { root.install-update(); }
                        }
                    }
                }
            }

            // Barra de status
            Rectangle {
                height: 32px;
                background: Theme.bg-0;
                border-width: 0;
                HorizontalLayout {
                    padding-left: Theme.sp-4;
                    padding-right: Theme.sp-4;
                    spacing: Theme.sp-2;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: root.gamepads.length > 0 ? Theme.success : Theme.text-muted;
                    }
                    Text {
                        text: root.gamepads.length > 0 ? @tr("{n} controller connected" | "{n} controllers connected" % root.gamepads.length) : @tr("No controller");
                        color: Theme.text-secondary;
                        font-size: Theme.fs-caption;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.live: VerticalLayout {
                        alignment: center;
                        LiveBadge { text: @tr("LIVE"); }
                    }
                    Text {
                        text: @tr("A Confirm · B Back · LB/RB Section · LT/RT Tab · Start Menu");
                        color: Theme.text-secondary;
                        font-size: Theme.fs-caption;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    vk := VirtualKeyboard {
        visible: root.modal == 1;
        width: root.width;
        height: root.height;
        title: root.keyboard-target == 0 ? @tr("Display name")
            : root.keyboard-target == 1 ? @tr("Server address")
            : root.keyboard-target == 2 ? @tr("Room creation key")
            : root.keyboard-target == 4 ? @tr("Public address for invites")
            : root.keyboard-target == 5 ? @tr("Invite link")
            : @tr("Room name");
        max-length: root.keyboard-target == 0 ? 32 : root.keyboard-target == 3 ? 64 : root.keyboard-target == 5 ? 1024 : 256;
        confirmed(text) => { root.keyboard-confirmed(text); }
        cancelled => { root.close-modal(); }
    }

    Rectangle {
        visible: root.modal == 2;
        background: #000000b3;
        // Teclado físico também navega o menu.
        menu-fs := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.UpArrow) { root.modal-action(NavAction.up); return accept; }
                if (event.text == Key.DownArrow) { root.modal-action(NavAction.down); return accept; }
                if (event.text == Key.Return || event.text == " ") { root.modal-action(NavAction.confirm); return accept; }
                if (event.text == Key.Escape) { root.modal-action(NavAction.back); return accept; }
                accept
            }
        }
        TouchArea { clicked => { root.close-modal(); } }
        Rectangle {
            width: 320px;
            height: menu.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg-1;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            menu := VerticalLayout {
                padding: Theme.sp-4;
                spacing: Theme.sp-1;
                Text { text: @tr("Menu"); color: Theme.text-secondary; font-size: Theme.fs-caption; font-weight: 600; }
                for label[i] in root.menu-items: MenuEntry {
                    label: label;
                    selected: root.menu-index == i;
                    activated => { root.run-menu(i); }
                }
            }
        }
    }
}
