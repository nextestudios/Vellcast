// Teclado virtual original do Vellcast (M-004, spec §14).
//
// Navegação: D-pad/analógico movem a seleção; A confirma a tecla;
// X apaga; Y insere espaço; Start confirma o texto; B cancela.
// O campo de prévia é um TextInput real: o teclado físico continua funcionando.

import { Theme, NavAction, TextOps } from "theme.slint";
import { FocusRing } from "widgets.slint";

component VKey inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> active;
    callback pressed;

    height: 44px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent : (root.active ? Theme.bg-hover : (ta.has-hover ? Theme.bg-hover : Theme.bg-3));
    ta := TouchArea { clicked => { root.pressed(); } }
    Text {
        text: root.label;
        color: root.selected ? Theme.on-accent : Theme.text-primary;
        font-size: Theme.fs-body-strong;
        font-weight: root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    FocusRing { visible-ring: root.selected; radius: Theme.radius-sm; }
}

export component VirtualKeyboard inherits Rectangle {
    in property <string> title;
    in property <int> max-length: 32;
    in-out property <string> value;
    callback confirmed(string);
    callback cancelled;

    // 0 = letras, 1 = números e símbolos, 2 = acentos.
    property <int> layer: 0;
    property <bool> shift: false;
    property <int> sel-row: 0;
    property <int> sel-col: 0;

    property <[[string]]> letters: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l", "-"],
        ["z", "x", "c", "v", "b", "n", "m", ",", ".", "_"],
    ];
    property <[[string]]> symbols: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["@", "#", "$", "%", "&", "*", "+", "=", "/", "\\"],
        ["(", ")", "[", "]", "{", "}", "<", ">", "|", "~"],
        ["!", "?", ":", ";", "'", "\"", "^", "`", ",", "."],
    ];
    property <[[string]]> accents: [
        ["á", "à", "â", "ã", "ä", "é", "è", "ê", "ë", "ç"],
        ["í", "ì", "î", "ï", "ó", "ò", "ô", "õ", "ö", "ñ"],
        ["ú", "ù", "û", "ü", "ý", "ÿ", "¿", "¡", "º", "ª"],
        ["€", "£", "¥", "§", "°", "·", "…", "«", "»", "•"],
    ];
    property <[[string]]> rows: root.layer == 0 ? root.letters : (root.layer == 1 ? root.symbols : root.accents);
    // A última linha é a de teclas especiais (6 teclas).
    property <int> special-row: root.rows.length;
    property <int> special-count: 6;

    function row-length(r: int) -> int {
        return r == root.special-row ? root.special-count : root.rows[r].length;
    }

    function display(key: string) -> string {
        return root.shift ? key.to-uppercase() : key;
    }

    function insert(key: string) {
        if (preview.text.character-count >= root.max-length) { return; }
        root.value = root.value + root.display(key);
        root.shift = false;
    }

    function backspace() {
        root.value = TextOps.pop-char(root.value);
    }

    function press(r: int, c: int) {
        root.sel-row = r;
        root.sel-col = c;
        if (r < root.special-row) {
            root.insert(root.rows[r][c]);
        } else if (c == 0) {
            root.shift = !root.shift;
        } else if (c == 1) {
            root.layer = Math.mod(root.layer + 1, 3);
        } else if (c == 2) {
            root.insert(" ");
        } else if (c == 3) {
            root.backspace();
        } else if (c == 4) {
            root.cancelled();
        } else {
            root.confirmed(root.value);
        }
    }

    // Chamado pelo Rust com as ações do controle.
    public function action(a: NavAction) {
        if (a == NavAction.up) {
            root.sel-row = max(0, root.sel-row - 1);
            root.sel-col = min(root.sel-col, root.row-length(root.sel-row) - 1);
        } else if (a == NavAction.down) {
            root.sel-row = min(root.special-row, root.sel-row + 1);
            root.sel-col = min(root.sel-col, root.row-length(root.sel-row) - 1);
        } else if (a == NavAction.left) {
            root.sel-col = Math.mod(root.sel-col - 1 + root.row-length(root.sel-row), root.row-length(root.sel-row));
        } else if (a == NavAction.right) {
            root.sel-col = Math.mod(root.sel-col + 1, root.row-length(root.sel-row));
        } else if (a == NavAction.confirm) {
            root.press(root.sel-row, root.sel-col);
        } else if (a == NavAction.back) {
            root.cancelled();
        } else if (a == NavAction.secondary) {
            root.backspace();
        } else if (a == NavAction.options) {
            root.insert(" ");
        } else if (a == NavAction.menu) {
            root.confirmed(root.value);
        }
    }

    public function open() {
        root.sel-row = 1;
        root.sel-col = 0;
        root.layer = 0;
        root.shift = false;
        preview.focus();
    }

    background: #000000b3;
    TouchArea { }

    Rectangle {
        width: min(parent.width - 2 * Theme.sp-6, 720px);
        height: panel.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg-1;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        accessible-role: groupbox;
        accessible-label: root.title;

        panel := VerticalLayout {
            padding: Theme.sp-6;
            spacing: Theme.sp-3;

            Text { text: root.title; color: Theme.text-primary; font-size: Theme.fs-section; font-weight: 600; }

            Rectangle {
                height: 44px;
                background: Theme.bg-0;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.accent;
                preview := TextInput {
                    x: Theme.sp-3;
                    width: parent.width - 2 * Theme.sp-3;
                    vertical-alignment: center;
                    text <=> root.value;
                    color: Theme.text-primary;
                    font-size: Theme.fs-body-strong;
                    single-line: true;
                    accepted => { root.confirmed(root.value); }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.cancelled();
                            return accept;
                        }
                        reject
                    }
                }
            }
            Text {
                text: preview.text.character-count + " / " + root.max-length;
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                horizontal-alignment: right;
            }

            for keys[r] in root.rows: HorizontalLayout {
                spacing: Theme.sp-1;
                for key[c] in keys: VKey {
                    label: root.display(key);
                    selected: root.sel-row == r && root.sel-col == c;
                    pressed => { root.press(r, c); }
                }
            }

            HorizontalLayout {
                spacing: Theme.sp-1;
                VKey {
                    horizontal-stretch: 2;
                    label: "⇧ Shift";
                    active: root.shift;
                    selected: root.sel-row == root.special-row && root.sel-col == 0;
                    pressed => { root.press(root.special-row, 0); }
                }
                VKey {
                    horizontal-stretch: 2;
                    label: root.layer == 0 ? "?123" : (root.layer == 1 ? "áç" : "abc");
                    selected: root.sel-row == root.special-row && root.sel-col == 1;
                    pressed => { root.press(root.special-row, 1); }
                }
                VKey {
                    horizontal-stretch: 5;
                    label: @tr("Space");
                    selected: root.sel-row == root.special-row && root.sel-col == 2;
                    pressed => { root.press(root.special-row, 2); }
                }
                VKey {
                    horizontal-stretch: 2;
                    label: "⌫";
                    selected: root.sel-row == root.special-row && root.sel-col == 3;
                    pressed => { root.press(root.special-row, 3); }
                }
                VKey {
                    horizontal-stretch: 2;
                    label: @tr("Cancel");
                    selected: root.sel-row == root.special-row && root.sel-col == 4;
                    pressed => { root.press(root.special-row, 4); }
                }
                VKey {
                    horizontal-stretch: 2;
                    label: @tr("OK");
                    selected: root.sel-row == root.special-row && root.sel-col == 5;
                    pressed => { root.press(root.special-row, 5); }
                }
            }

            Text {
                text: @tr("A: press key · X: backspace · Y: space · Start: confirm · B: cancel");
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                horizontal-alignment: center;
            }
        }
    }
}
