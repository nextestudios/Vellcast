# Segredo HMAC dos tokens (obrigatório, >= 32 bytes). Gere com: openssl rand -hex 32
VELLCAST_RELAY_SECRET=
# Rotação sem queda: coloque aqui o segredo ANTERIOR por até 24 h (TTL dos tokens) e depois apague.
VELLCAST_RELAY_SECRET_PREVIOUS=
# Persistência das salas (SQLite). Vazio = só memória (salas somem ao reiniciar).
VELLCAST_DB_PATH=/data/relay.db
# Opcional: exige "Authorization: Bearer <chave>" para criar salas (recomendado em servidores públicos).
VELLCAST_CREATE_ROOM_KEY=
# Atrás de proxy reverso que define X-Forwarded-For.
VELLCAST_TRUST_PROXY=true
VELLCAST_MAX_ROOMS=1000
VELLCAST_MAX_VIEWERS_PER_ROOM=50
VELLCAST_MAX_PUBLISHER_KBPS=40000
